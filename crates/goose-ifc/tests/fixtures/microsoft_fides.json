      "items": [{"text": "fixture restricted result"}],
      "expected_labels": ["untrusted_private"], "hidden": [true], "context": "trusted_private"
    },
    {
      "id": "mixed_items", "upstream_test": "TestPerItemEmbeddedLabels.test_mixed_trust_items_in_list",
      "fallback": "untrusted_public", "initial": "trusted_public", "auto_hide": true,
      "items": [{"text": "fixture public result", "label": "trusted_public"}, {"text": "fixture restricted result", "label": "untrusted_private"}],
      "expected_labels": ["trusted_public", "untrusted_private"], "hidden": [false, true], "context": "trusted_private"
    },
    {
      "id": "public_overrides_private_fallback", "upstream_test": "TestTieredLabelPropagation.test_embedded_labels_override_source_integrity",
      "extension": "Exercise the same precedence with a private fallback and exclusively public items.",
      "fallback": "untrusted_private", "initial": "trusted_public", "auto_hide": true,
      "items": [{"text": "fixture public result", "label": "trusted_public"}],
      "expected_labels": ["trusted_public"], "hidden": [false], "context": "trusted_public"
    },
    {
      "id": "missing_label_uses_fallback", "upstream_test": "TestPerItemEmbeddedLabels.test_items_without_labels_use_fallback",
      "fallback": "untrusted_private", "initial": "trusted_public", "auto_hide": true,
      "items": [{"text": "fixture public result", "label": "trusted_public"}, {"text": "fixture unspecified result"}],
      "expected_labels": ["trusted_public", "untrusted_private"], "hidden": [false, true], "context": "trusted_private"
    },
    {
      "id": "visible_metadata", "upstream_test": "TestPerItemEmbeddedLabels.test_mixed_trust_items_in_list",
      "extension": "Retain non-label content properties and explicitly supplied label metadata.",
      "fallback": "untrusted_public", "initial": "trusted_public", "auto_hide": true,
      "items": [{"text": "fixture public result", "label": "metadata_first", "metadata": {"presentation": {"format": "plain"}}}],
      "expected_labels": ["metadata_first"], "hidden": [false], "context": "trusted_public"
    },
    {
      "id": "hiding_disabled", "upstream_test": "TestPerItemEmbeddedLabels.test_mixed_trust_items_in_list",
      "extension": "Run with auto-hide disabled.",
      "fallback": "untrusted_private", "initial": "trusted_public", "auto_hide": false,
      "items": [{"text": "fixture restricted result"}],
      "expected_labels": ["untrusted_private"], "hidden": [false], "context": "untrusted_private"
    },
    {
      "id": "already_untrusted", "upstream_test": "TestPerItemEmbeddedLabels.test_mixed_trust_items_in_list",
      "extension": "Start with an untrusted context, where hiding no longer applies.",
      "fallback": "untrusted_private", "initial": "untrusted_public", "auto_hide": true,
      "items": [{"text": "fixture restricted result"}],
      "expected_labels": ["untrusted_private"], "hidden": [false], "context": "untrusted_private"
    },
    {
      "id": "context_never_downgrades", "upstream_test": "TestPerItemEmbeddedLabels.test_mixed_trust_items_in_list",
      "extension": "Start private and untrusted, then receive public trusted content.",
      "fallback": "trusted_public", "initial": "untrusted_private", "auto_hide": true,
      "items": [{"text": "fixture public result"}],
      "expected_labels": ["trusted_public"], "hidden": [false], "context": "untrusted_private"
    },
    {
      "id": "empty_result", "upstream_test": "TestPerItemEmbeddedLabels.test_items_without_labels_use_fallback",
      "extension": "An empty result retains fallback confidentiality without exposing integrity.",
      "fallback": "untrusted_private", "initial": "trusted_public", "auto_hide": true,
      "items": [], "expected_labels": [], "hidden": [], "context": "trusted_private"
    }
