      "fallback": "trusted_public", "initial": "trusted_public", "auto_hide": true,
      "items": [{"text": "fixture public result"}],
      "expected_labels": ["trusted_public"], "hidden": [false], "context": "trusted_public"
    },
    {
      "id": "hidden_private", "upstream_test": "TestPerItemEmbeddedLabels.test_hidden_untrusted_items_do_not_taint_integrity_in_mixed_results",
